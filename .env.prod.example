# ============================================================
# PRODUCCIÓN - plantilla. Copia a .env.prod (ignorado por git) y rellena los valores.
# NUNCA subas .env.prod al repositorio ni lo copies dentro de una imagen Docker.
# ============================================================
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE"
DEV_MODE=false
DISABLE_DEV_PIN=true
ADMIN_PASSWORD="<contraseña-larga-y-aleatoria>"
ADMIN_NOTIFICATION_EMAIL="community@forobuap.zrootsh.com"
CORS_ORIGINS="https://tu-dominio-frontend"

RESEND_API_KEY="<resend-api-key>"
RESEND_FROM_EMAIL="community@forobuap.zrootsh.com"
RESEND_FROM_NAME="Foro Comunidad BUAP 🐺"

emailVerifierURL="https://api.hunter.io/v2/email-verifier"
emailVerifierKey="<hunter-api-key>"

PORT=8001
VOTE_WINDOW_DAYS=7
AUTO_APPROVE_MIN_VOTES=10
AUTO_APPROVE_RATIO=0.51
