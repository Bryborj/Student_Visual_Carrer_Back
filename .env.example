# ============================================================
# Student Visual Carrer - Configuración de Variables de Entorno (DESARROLLO)
# Copia este archivo a .env:  cp .env.example .env
# Para producción usa .env.prod (ver .env.prod.example).
# ============================================================

# 1. Base de Datos PostgreSQL (Postgres local del docker-compose)
DATABASE_URL="postgresql://postgres:devpassword@localhost:5433/forobuap_dev"

# 2. Resend Email Service (Transactional Emails)
# Obtén tu clave en https://resend.com/api-keys (vacío = el PIN se devuelve en modo dev)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="community@forobuap.zrootsh.com"
RESEND_FROM_NAME="Foro Comunidad BUAP 🐺"

# Correo al que se notificarán cambios y auto-aprobaciones de planes
ADMIN_NOTIFICATION_EMAIL="community@forobuap.zrootsh.com"

# 3. Seguridad y Administración
ADMIN_PASSWORD="change-me"
DISABLE_DEV_PIN=false
DEV_MODE=true
# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGINS="http://localhost:5400,http://localhost:5173"

# 4. Verificador Externo Hunter API (Opcional)
emailVerifierURL="https://api.hunter.io/v2/email-verifier"
emailVerifierKey=""

# 5. Parámetros de Gobernanza y Votación Estudiantil
VOTE_WINDOW_DAYS=7
AUTO_APPROVE_MIN_VOTES=10
AUTO_APPROVE_RATIO=0.51
